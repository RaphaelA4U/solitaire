#!/bin/sh
# Solitaire launcher: runs the app from the ~/.solitaire checkout.
# POSIX sh on purpose: iSH/Alpine have no bash by default.
APP_DIR="${SOLITAIRE_HOME:-$HOME/.solitaire}"

if [ ! -x "$APP_DIR/.venv/bin/python" ]; then
    echo "Solitaire is not installed correctly. Reinstall with:"
    echo "  curl -fsSL https://raw.githubusercontent.com/RaphaelA4U/solitaire/main/install.sh | sh"
    exit 1
fi

exec "$APP_DIR/.venv/bin/python" -m solitaire_app "$@"
